# Optional: only when the API lives on another origin. By default the app calls
# same-origin /api (proxied by Vite in dev, nginx or Vercel in production).
# VITE_API_BASE_URL=http://localhost:5119/api

# Google OAuth client ID (public, not the client secret). Leave empty to hide
# the "Sign in with Google" button. Put real values in .env.local (gitignored).
VITE_GOOGLE_CLIENT_ID=
