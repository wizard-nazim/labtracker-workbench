# Settings for docker-compose.prod.yml. Don't copy this by hand: run
# deploy/generate-env.sh, which writes .env.production (gitignored, mode 600)
# with fresh random secrets, then edit the values marked EDIT.
# Never commit .env.production. Back it up somewhere safe and offline: the
# database and storage backups are useless without the secrets in it.

# --- Release -----------------------------------------------------------------
# Tag of the images to run. deploy/deploy.sh writes the deployed git commit
# here, so `docker compose ... up -d` reuses those images. Don't edit by hand.
APP_VERSION=latest

# --- Web (the only published port) --------------------------------------------
# Host address nginx listens on. 127.0.0.1 = this server only (a Cloudflare
# Tunnel on the same host can still reach it). Set to the LAN IP, e.g.
# 10.0.0.20, to let other machines on the LAN test it. Never 0.0.0.0.
WEB_BIND=127.0.0.1
WEB_PORT=8080

# EDIT: hostnames browsers use, semicolon-separated and quoted. Requests with
# any other Host header get 400 from the API. Keep 127.0.0.1 (health checks on
# the server) and add the Cloudflare hostname when you set up the tunnel.
ALLOWED_HOSTS="localhost;127.0.0.1;10.0.0.20"

# --- Postgres --------------------------------------------------------------
POSTGRES_DB=labtracker
POSTGRES_USER=labtracker
# Hex only: it goes into a connection string, where ; and = would break it.
POSTGRES_PASSWORD=

# --- API ---------------------------------------------------------------------
# At least 32 random bytes. Changing it signs everyone out.
JWT_SIGNING_KEY=

# Apply pending EF Core migrations when the API starts. deploy/deploy.sh backs
# up the database first.
MIGRATE_ON_STARTUP=true

# EDIT, first start only: creates this Super Admin if the database has no
# users (password at least 12 characters). After the first start, set a new
# password (Admin -> People -> Users -> Edit login) and empty both values.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Google sign-in (optional): the OAuth client ID only. Empty hides the button.
# Changing it needs a rebuild (it's baked into the frontend).
GOOGLE_CLIENT_ID=

# Admin -> "Import MCB equipment". Turn on only while importing.
FEATURE_MCB_IMPORT=false

# Sign-in attempts per client IP per minute. Behind a tunnel, see the
# Cloudflare section of docs/deploy-homelab.md before raising it.
LOGIN_RATE_LIMIT=10

# --- Garage (object storage) -------------------------------------------------
# 32 random bytes, hex.
GARAGE_RPC_SECRET=
# Access key ID: GK followed by 24 hex characters. Secret: 64 hex characters.
S3_ACCESS_KEY=
S3_SECRET_KEY=
