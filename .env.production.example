# Copy to .env.production (gitignored) and fill in. Never commit real values.

# Postgres, e.g. Supabase: use the direct or session-pooler connection
# (port 5432), not the transaction pooler (6543), so migrations can run.
DATABASE_CONNECTION_STRING=Host=YOUR_HOST;Port=5432;Database=postgres;Username=YOUR_USER;Password=YOUR_PASSWORD;SSL Mode=Require

# At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SIGNING_KEY=

# Apply EF migrations when the API starts (single-instance deploys).
MIGRATE_ON_STARTUP=true

# First start only: creates this Super Admin if the database has no users.
# Remove both after the first start, then change the password in the app.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Your public hostname(s), semicolon-separated.
ALLOWED_HOSTS=labtracker.example.org

# S3-compatible storage for equipment images (AWS S3, MinIO, Supabase Storage S3).
S3_SERVICE_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=labtracker-equipment
S3_PUBLIC_BASE_URL=

WEB_PORT=80
